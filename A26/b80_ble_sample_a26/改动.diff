+	/* A26-2 / A27-1 verification: BDT flash read/write fails on this board after the firmware has run,
+	 * so the firmware checks the calibration sector and the flash lock by itself. */
+	{
+		/* A26-2: 0x7e000 empty -> write test cap 0x15 (applied on next boot); only test value present -> erase back */
+		u8 buf[16], b, v;
+		u32 sum = 0;
+		u16 nonff = 0, first = 0xffff;
+		for(u32 off = 0; off < 4096; off += 16){
+			flash_read_page(0x7e000 + off, 16, buf);
+			for(int i = 0; i < 16; i++){
+				sum += buf[i];
+				if(buf[i] != 0xff){
+					nonff++;
+					if(first == 0xffff){ first = off + i; }
+				}
+			}
+		}
+		flash_read_page(0x7e000, 1, &b);
+		printf("[A26][SECT] 0x7e000: non-FF %d, sum 0x%x, first non-FF offset 0x%x\n", nonff, sum, first);
+		if(nonff == 0){
+			v = 0x15;
+			flash_write_page(0x7e000, 1, &v);
+			flash_read_page(0x7e000, 1, &b);
+			printf("[A26][CAP] wrote 0x15 to 0x7e000, read back 0x%x, press SW1 to reboot\n", b);
+		}
+		else if(nonff == 1 && first == 0 && b == 0x15){
+			flash_erase_sector(0x7e000);
+			flash_read_page(0x7e000, 1, &b);
+			printf("[A26][CAP] test value seen, sector erased, read back 0x%x\n", b);
+		}
+		else{
+			printf("[A26][CAP] sector not empty, left untouched\n");
+		}
+	}
+	{
+		/* A27-1: write 0x5a into 0x3f000 (inside the locked low 256K, unused) while locked, then unlocked, then erase and relock */
+		extern flash_get_lock_status_t flash_get_lock_status_mid;
+		extern u16 flash_lockBlock_cmd;
+		u32 a = 0x3f000;
+		u8 v = 0x5a, b0, b1, b2, b3;
+		flash_read_page(a, 1, &b0);
+		if(b0 == 0xff && flash_get_lock_status_mid){
+			u16 st0 = flash_get_lock_status_mid();
+			flash_write_page(a, 1, &v);
+			flash_read_page(a, 1, &b1);
+			flash_unlock();
+			u16 st1 = flash_get_lock_status_mid();
+			flash_write_page(a, 1, &v);
+			flash_read_page(a, 1, &b2);
+			flash_erase_sector(a);
+			flash_read_page(a, 1, &b3);
+			flash_lock(flash_lockBlock_cmd);
+			u16 st2 = flash_get_lock_status_mid();
+			printf("[A27][PROT] lock status 0x%x, write 5a while locked -> 0x%x\n", st0, b1);
+			printf("[A27][PROT] unlock status 0x%x, write 5a -> 0x%x, erase -> 0x%x, relock status 0x%x (cmd 0x%x)\n", st1, b2, b3, st2, flash_lockBlock_cmd);
+		}
+		else{
+			printf("[A27][PROT] skipped: 0x3f000 = 0x%x\n", b0);
+		}
+	}
