+int app_host_event_callback (u32 h, u8 *para, int n)
+{
+	(void)n;
+	switch(h & 0xFF)
+	{
+		case GAP_EVT_SMP_PAIRING_BEGIN:
+			printf("[A18][SMP] pairing begin\n");
+			break;
+		case GAP_EVT_SMP_PAIRING_SUCCESS:
+		{
+			gap_smp_pairingSuccessEvt_t* pe = (gap_smp_pairingSuccessEvt_t*)para;
+			printf("[A18][SMP] pairing success, bonding %d, save result %d\n", pe->bonding, pe->bonding_result);
+		}
+			break;
+		case GAP_EVT_SMP_PAIRING_FAIL:
+		{
+			gap_smp_pairingFailEvt_t* pe = (gap_smp_pairingFailEvt_t*)para;
+			printf("[A18][SMP] pairing failed, reason 0x%x\n", pe->reason);
+		}
+			break;
+		case GAP_EVT_SMP_CONN_ENCRYPTION_DONE:
+		{
+			gap_smp_connEncDoneEvt_t* pe = (gap_smp_connEncDoneEvt_t*)para;
+			printf("[A18][SMP] encryption done, %s\n", pe->re_connect == SMP_STANDARD_PAIR ? "first pairing" : "reconnect");
+		}
+			break;
+		default:
+			break;
+	}
+	return 0;
+}
