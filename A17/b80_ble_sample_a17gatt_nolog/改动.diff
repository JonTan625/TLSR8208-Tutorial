+//// my demo service (A17) ////
+#define MY_UUID(n)  n,0x00,0x6E,0x2B,0x5A,0x1C,0x4B,0x8E,0x9D,0x3F,0x27,0x61,0x00,0x00,0xA8,0x6F
+static const u8 my_demoServiceUUID[16] = {MY_UUID(0x01)};
+static const u8 my_demoLedUUID[16]     = {MY_UUID(0x02)};
+static const u8 my_demoCntUUID[16]     = {MY_UUID(0x03)};
+static u8 myLedVal[1] = {0};
+static u8 myCntVal[4] = {0};
+static u8 myCntCCC[2] = {0};
+
+static const u8 my_demoLedCharVal[19] = {
+	CHAR_PROP_READ | CHAR_PROP_WRITE | CHAR_PROP_WRITE_WITHOUT_RSP,
+	U16_LO(MY_LED_DP_H), U16_HI(MY_LED_DP_H),
+	MY_UUID(0x02)
+};
+static const u8 my_demoCntCharVal[19] = {
+	CHAR_PROP_READ | CHAR_PROP_NOTIFY,
+	U16_LO(MY_CNT_DP_H), U16_HI(MY_CNT_DP_H),
+	MY_UUID(0x03)
+};
+
+int my_demoLedWrite(void *p)                     // 写回调
+{
+	rf_packet_att_data_t *pw = (rf_packet_att_data_t *)p;
+	int len = pw->l2capLen - 3;
+	if(len >= 1){
+		myLedVal[0] = pw->dat[0];                // 有回调时协议栈不自动拷，自己存
+		#if (UI_LED_ENABLE)
+			gpio_write(GPIO_LED_WHITE, myLedVal[0] ? LED_ON_LEVEL : !LED_ON_LEVEL);
+		#endif
+	}
+	return 0;
+}
+
+void my_demoCntNotify(u32 cnt)                   // 手机打开了 Notify 才发
+{
+	if(myCntCCC[0] & 0x01){
+		memcpy(myCntVal, &cnt, 4);
+		blc_gatt_pushHandleValueNotify(BLS_CONN_HANDLE, MY_CNT_DP_H, myCntVal, 4);
+	}
+}
