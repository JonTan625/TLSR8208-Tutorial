--- a/demo/vendor/Debug_Demo/app.c
+++ b/demo/vendor/Debug_Demo/app.c
@@ -23,6 +23,28 @@
  *******************************************************************************************************/
 #include "app_config.h"
 
+/* A13：读写板上 EEPROM P24C02A（SDA PD5、SCL PD6、WP PD7），按正文第 03 节的代码重建 */
+#define EE_SDA   GPIO_PD5
+#define EE_SCL   GPIO_PD6
+#define EE_WP    GPIO_PD7
+
+unsigned char wbuf[8] = {0x11,0x22,0x33,0x44,0x55,0x66,0x77,0x88};
+unsigned char rbuf[8];
+
+void ee_test(void)
+{
+    gpio_set_func(EE_WP, AS_GPIO);              // WP 拉低，允许写
+    gpio_set_output_en(EE_WP, 1);
+    gpio_write(EE_WP, 0);
+
+    i2c_gpio_set(EE_SDA, EE_SCL);               // 内部 10 kΩ 上拉，100 kHz 够用
+    i2c_master_init(0xA0, (unsigned char)(CLOCK_SYS_CLOCK_HZ / (4 * 100000)));
+
+    i2c_write_series(0x00, 1, wbuf, 8);         // 从 EEPROM 地址 0 写一页
+    sleep_ms(10);                               // 等内部写周期
+    i2c_read_series(0x00, 1, rbuf, 8);          // 读回来
+}
+
 void user_init(void)
 {
 	sleep_ms(1000);
@@ -64,6 +86,8 @@
 	printf("\n Driver version: %2x \n Copyright (c) %d Telink semiconductor (%s) Ltd, Co \n",0xa001,2019,"shanghai");
 #endif
 
+	ee_test();	//A13
+	printf("rbuf = %x %x %x %x %x %x %x %x\n", rbuf[0], rbuf[1], rbuf[2], rbuf[3], rbuf[4], rbuf[5], rbuf[6], rbuf[7]);	//A13
 }
 
 
