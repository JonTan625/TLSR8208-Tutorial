+/* Private functions ---------------------------------------------------------*/
+
+/* Reconfigure the channel with the output buffer on or off, then restore the code.
+ * HAL_DAC_SetConfigChannel() needs the channel stopped (idle state). */
+static app_status_t dac_apply_buffer(uint32_t buffer_on)
+{
+  hal_dac_channel_config_t ch;
+
+  if (HAL_DAC_StopChannel(pDAC, MX_DAC_CHANNEL) != HAL_OK)
+  {
+    return EXEC_STATUS_ERROR;
+  }
+
+  ch.data_sign_format  = HAL_DAC_SIGN_FORMAT_UNSIGNED;
+  ch.trigger           = HAL_DAC_TRIGGER_NONE;
+  ch.output_buffer     = (buffer_on != 0U) ? HAL_DAC_OUTPUT_BUFFER_ENABLED : HAL_DAC_OUTPUT_BUFFER_DISABLED;
+  ch.output_connection = HAL_DAC_OUTPUT_CONNECTION_EXTERNAL;
+  ch.alignment         = HAL_DAC_DATA_ALIGN_12_BITS_RIGHT;
+  if (HAL_DAC_SetConfigChannel(pDAC, MX_DAC_CHANNEL, &ch) != HAL_OK)
+  {
+    return EXEC_STATUS_ERROR;
+  }
+
+  if (buffer_on != 0U)
+  {
+    if (HAL_DAC_CalibrateChannelBuffer(pDAC, MX_DAC_CHANNEL) != HAL_OK)
+    {
+      return EXEC_STATUS_ERROR;
+    }
+  }
+
+  if (HAL_DAC_StartChannel(pDAC, MX_DAC_CHANNEL) != HAL_OK)
+  {
+    return EXEC_STATUS_ERROR;
+  }
+
+  if (HAL_DAC_SetChannelData(pDAC, MX_DAC_CHANNEL, dac_code) != HAL_OK)
+  {
+    return EXEC_STATUS_ERROR;
+  }
+
+  dac_buffer_on = (buffer_on != 0U) ? 1U : 0U;
+  return EXEC_STATUS_OK;
+}
+
+static void uart_puts(const char *s)
+{
+  (void)HAL_UART_Transmit(pUART, s, (uint32_t)strlen(s), 100U);
+}
+
+static void reply_state(void)
+{
+  char buf[64];
+  uint32_t mv = (dac_code * vref_mv + (DAC_CODE_MAX / 2U)) / DAC_CODE_MAX;
+
+  (void)snprintf(buf, sizeof(buf), "OK code=%lu mv=%lu buf=%lu vref=%lu\r\n",
+                 (unsigned long)dac_code, (unsigned long)mv,
+                 (unsigned long)dac_buffer_on, (unsigned long)vref_mv);
+  uart_puts(buf);
+}
+
+/* Parse a decimal number after optional spaces; returns 0 on success. */
+static int32_t parse_uint(const char *s, uint32_t *value)
+{
+  uint32_t v = 0U;
+  uint32_t digits = 0U;
+
+  while (*s == ' ')
+  {
+    s++;
+  }
+  while ((*s >= '0') && (*s <= '9'))
+  {
+    v = (v * 10U) + (uint32_t)(*s - '0');
+    s++;
+    digits++;
+    if (digits > 6U)
+    {
+      return -1;
+    }
+  }
+  while (*s == ' ')
+  {
+    s++;
+  }
+  if ((digits == 0U) || (*s != '\0'))
+  {
+    return -1;
+  }
+  *value = v;
+  return 0;
+}
+
+static void handle_line(void)
+{
+  uint32_t v;
+  char cmd = cmd_line[0];
+
+  if (cmd == '?')
+  {
+    reply_state();
+    return;
+  }
+
+  if (parse_uint(&cmd_line[1], &v) != 0)
+  {
+    uart_puts("ERR syntax\r\n");
+    return;
+  }
+
+  switch (cmd)
+  {
+    case 'M':
+    case 'm':
+      if (v > vref_mv)
+      {
+        uart_puts("ERR range\r\n");
+        return;
+      }
+      dac_code = ((v * DAC_CODE_MAX) + (vref_mv / 2U)) / vref_mv;
+      break;
+
+    case 'C':
+    case 'c':
+      if (v > DAC_CODE_MAX)
+      {
+        uart_puts("ERR range\r\n");
+        return;
+      }
+      dac_code = v;
+      break;
+
+    case 'B':
+    case 'b':
+      if (v > 1U)
+      {
+        uart_puts("ERR range\r\n");
+        return;
+      }
+      if (dac_apply_buffer(v) != EXEC_STATUS_OK)
+      {
+        uart_puts("ERR dac\r\n");
+        return;
+      }
+      reply_state();
+      return;
+
+    case 'R':
+    case 'r':
+      if ((v < 2500U) || (v > 3600U))
+      {
+        uart_puts("ERR range\r\n");
+        return;
+      }
+      vref_mv = v;
+      reply_state();
+      return;
+
+    default:
+      uart_puts("ERR cmd\r\n");
+      return;
+  }
+
+  if (HAL_DAC_SetChannelData(pDAC, MX_DAC_CHANNEL, dac_code) != HAL_OK)
+  {
+    uart_puts("ERR dac\r\n");
+    return;
+  }
+  reply_state();
+}
