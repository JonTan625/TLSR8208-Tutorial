--- a/vendor/ble_sample/app_att.c
+++ b/vendor/ble_sample/app_att.c
@@ -88,6 +88,28 @@
 static u8 batteryValueInCCC[2];
 static u8 my_batVal[1] 	= {99};
 
+/* A29: battery voltage -> level, notify on change */
+void app_batt_level_update(u16 vol_mv)
+{
+	u8 level;
+	if(vol_mv >= 3000){
+		level = 100;
+	}
+	else if(vol_mv <= 2000){
+		level = 0;
+	}
+	else{
+		level = (vol_mv - 2000) / 10;   // 两节 AA：2.0 V 记 0%、3.0 V 记 100%，线性近似
+	}
+
+	if(level != my_batVal[0]){
+		my_batVal[0] = level;
+		if(blc_ll_getCurrentState() == BLS_LINK_STATE_CONN && (batteryValueInCCC[0] & 0x01)){
+			blc_gatt_pushHandleValueNotify(BLS_CONN_HANDLE, BATT_LEVEL_INPUT_DP_H, my_batVal, 1);
+		}
+	}
+}
+
